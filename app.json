{
  "expo": {
    "name": "Receipts",
    "slug": "pointtracker",
    "owner": "beanswallowers-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pointtracker",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.antoniofodor.receipts",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "UIViewEdgeAntialiasing": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.antoniofodor.receipts",
      "adaptiveIcon": {
        "backgroundColor": "#EAE9E4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EAE9E4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Receipts uses your photos so you can attach evidence to an entry or set your profile photo.",
          "cameraPermission": "Receipts uses your camera so you can photograph evidence for an entry or take your profile photo.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Receipts uses your photos so you can attach evidence to an entry or set your profile photo.",
          "savePhotosPermission": "Receipts saves receipts and photos to your library when you ask it to.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6fe0d2bc-e093-4d82-99d2-a020b67c90c6"
      }
    }
  }
}
